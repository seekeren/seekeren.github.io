[{"content":"public static void sendMsg(DataPacket prototype) { for (Channel channel : clients) { if (channel.isActive()) { ByteBuf byteBuf = prototype.toByteBufMsg(); prototype.setPayload(byteBuf); log.info(\u0026#34;体信息:{}\u0026#34;, CodecUtils.byteBufToHex(byteBuf)); log.info(\u0026#34;原始包中的buf: {}\u0026#34;, CodecUtils.byteBufToHex(prototype.getPayload())); log.info(\u0026#34;发送消息给客户端: {}\u0026#34;, channel.remoteAddress()); channel.writeAndFlush(prototype); } } } ","permalink":"https://seekeren.github.io/posts/first-post/","summary":"\u003cdiv class=\"highlight\"\u003e\u003cpre tabindex=\"0\" style=\"color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;\"\u003e\u003ccode class=\"language-java\" data-lang=\"java\"\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e\u003cspan style=\"color:#66d9ef\"\u003epublic\u003c/span\u003e \u003cspan style=\"color:#66d9ef\"\u003estatic\u003c/span\u003e \u003cspan style=\"color:#66d9ef\"\u003evoid\u003c/span\u003e \u003cspan style=\"color:#a6e22e\"\u003esendMsg\u003c/span\u003e(DataPacket prototype) {\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e        \u003cspan style=\"color:#66d9ef\"\u003efor\u003c/span\u003e (Channel channel : clients) {\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e            \u003cspan style=\"color:#66d9ef\"\u003eif\u003c/span\u003e (channel.\u003cspan style=\"color:#a6e22e\"\u003eisActive\u003c/span\u003e()) {\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e                ByteBuf byteBuf \u003cspan style=\"color:#f92672\"\u003e=\u003c/span\u003e prototype.\u003cspan style=\"color:#a6e22e\"\u003etoByteBufMsg\u003c/span\u003e();\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e                prototype.\u003cspan style=\"color:#a6e22e\"\u003esetPayload\u003c/spa