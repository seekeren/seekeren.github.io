&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#66d9ef"&gt;for&lt;/span&gt; (Channel channel : clients) {
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#66d9ef"&gt;if&lt;/span&gt; (channel.&lt;span style="color:#a6e22e"&gt;isActive&lt;/span&gt;()) {
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; ByteBuf byteBuf &lt;span style="color:#f92672"&gt;=&lt;/span&gt; prototype.&lt;span style="color:#a6e22e"&gt;toByteBufMsg&lt;/span&gt;();
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; prototype.&lt;span style="color:#a6e22e"&gt;setPayload&lt;/span&gt;(byteBuf);
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; log.&lt;span style="color:#a6e22e"&gt;info&lt;/span&gt;(&lt;span style="color:#e6db74"&gt;&amp;#34;体信息:{}&amp;#34;&lt;/span&gt;, CodecUtils.&lt;span style="color:#a6e22e"&gt;byteBufToHex&lt;/span&gt;(byteBuf));
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; log.&lt;span style="color:#a6e22e"&gt;info&lt;/span&gt;(&lt;span style="color:#e6db74"&gt;&amp;#34;原始包中的buf: {}&amp;#34;&lt;/span&gt;, CodecUtils.&lt;span style="color:#a6e22e"&gt;byteBufToHex&lt;/span&gt;(prototype.&lt;span style="color:#a6e22e"&gt;getPayload&lt;/span&gt;()));
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; log.&lt;span style="color:#a6e22e"&gt;info&lt;/span&gt;(&lt;span style="color:#e6db74"&gt;&amp;#34;发送消息给客户端: {}&amp;#34;&lt;/span&gt;, channel.&lt;span style="color:#a6e22e"&gt;remoteAddress&lt;/span&gt;());
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; channel.&lt;span style="color:#a6e22e"&gt;writeAndFlush&lt;/span&gt;(prototype);
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; }
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; }
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; }
